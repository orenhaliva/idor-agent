# Gemini API keys (AI Studio, free tier works). Comma-separate several keys; the pool rotates key x model.
GEMINI_API_KEYS=your-key-1,your-key-2

# Optional: override the model order (strongest first). Default: see tools/gemini_pool.py DEFAULT_MODELS
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
